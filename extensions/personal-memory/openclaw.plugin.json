{
  "id": "personal-memory",
  "name": "Personal Memory",
  "description": "Private per-employee memory profiles keyed from trusted runtime identity.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "personal_memory_list",
      "personal_memory_remember",
      "personal_memory_forget"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },
      "storePath": { "type": "string" },
      "scopeId": { "type": "string" },
      "allowSharedScope": { "type": "boolean" },
      "readsRequirePrivateConversation": { "type": "boolean" },
      "acknowledgeInstalledPluginTrustBoundary": { "type": "boolean" },
      "experimentalAutoCaptureAcknowledge": { "type": "boolean" },
      "storeRawIdentityForRepair": { "type": "boolean" },
      "atRestEncryption": { "type": "boolean" },
      "prompt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxItems": { "type": "number" },
          "maxChars": { "type": "number" }
        }
      },
      "autoCapture": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "suggestOnly": { "type": "boolean" }
        }
      },
      "admin": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowOwnerInspect": { "type": "boolean" }
        }
      }
    }
  }
}
